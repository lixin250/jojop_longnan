# 复制为 secrets.env 后填写。不要提交 secrets.env。
# 海螺/MiniMax 开放平台：https://platform.minimaxi.com 或 https://platform.minimax.io

# 必填：API Key（控制台「接口密钥」）
MINIMAX_API_KEY=

# 国内账号通常还要 GroupId（控制台右上角）
MINIMAX_GROUP_ID=

# 国内默认；国际站改成 https://api.minimax.io
MINIMAX_BASE_URL=https://api.minimax.chat

# 克隆与合成模型：年费走 HD。turbo 更便宜。
MINIMAX_MODEL=speech-2.8-hd
