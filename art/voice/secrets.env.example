# —— 人声：MiniMax / 海螺 ——
# https://platform.minimaxi.com 或 https://platform.minimax.io
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_MODEL=speech-2.8-hd

